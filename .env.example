# What to watch: either a comma-separated address list...
PERMWATCH_ADDRESSES=klv1x4lhywvzqt4dhz92tps2a2jfrsn2qljz7c89njver2e6nmamkjhq62e787
# ...or a YAML file with labels, owners and vaults (see permwatch.example.yaml). Not both.
# PERMWATCH_CONFIG_FILE=./permwatch.yaml

# Mainnet is the default: https://api.mainnet.klever.org and https://node.mainnet.klever.org
PERMWATCH_API_URL=https://api.testnet.klever.org
PERMWATCH_NODE_URL=https://node.testnet.klever.org

PERMWATCH_POLL_INTERVAL=1m
PERMWATCH_HTTP_ADDR=:8080
PERMWATCH_STATE_DIR=./data

# Optional alert channels. The log always receives alerts.
PERMWATCH_WEBHOOK_URL=
PERMWATCH_TELEGRAM_BOT_TOKEN=
PERMWATCH_TELEGRAM_CHAT_ID=
